<Window
    x:Class="ControlBeeWPF.Views.KeyboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="clr-namespace:ControlBeeWPF.ViewModels"
    Title="Keyboard"
    Width="940"
    Height="470"
    Background="White"
    PreviewKeyDown="Window_PreviewKeyDown"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Window.Resources>
        <SolidColorBrush x:Key="FunctionKeyBrush" Color="#EEEEF0" />
        <SolidColorBrush x:Key="KeyPressedBrush" Color="#E3E4E6" />
        <SolidColorBrush x:Key="LedOffBrush" Color="#D6D6D6" />
        <SolidColorBrush x:Key="LedOnBrush" Color="#34C759" />

        <!--  A flat key; pressing it only tints the face  -->
        <ControlTemplate x:Key="KeyTemplate" TargetType="Button">
            <Border
                x:Name="Face"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="5">
                <Grid>
                    <ContentPresenter
                        Margin="{TemplateBinding Padding}"
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    <!--  Caps lock LED; the key style puts its brush in Tag, other keys leave it null  -->
                    <Ellipse
                        Width="6"
                        Height="6"
                        Margin="9,8,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Fill="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Face" Property="Background" Value="{StaticResource KeyPressedBrush}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="KeyButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="5" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#1D1D1F" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#26000000" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template" Value="{StaticResource KeyTemplate}" />
        </Style>

        <Style x:Key="KeyboardButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#1D1D1F" />
            <Setter Property="BorderBrush" Value="#26000000" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="MinWidth" Value="80" />
            <Setter Property="MinHeight" Value="52" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Template" Value="{StaticResource KeyTemplate}" />

            <!--  Wide keys are sized so the qwerty, shift and space rows all span the same width  -->
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsWide}" Value="True">
                    <Setter Property="MinWidth" Value="467" />
                    <Setter Property="FontSize" Value="13" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Shift">
                    <Setter Property="MinWidth" Value="123" />
                    <Setter Property="FontSize" Value="13" />
                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                    <Setter Property="VerticalContentAlignment" Value="Bottom" />
                    <Setter Property="Padding" Value="9,0,0,6" />
                    <Setter Property="Background" Value="{StaticResource FunctionKeyBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Back">
                    <Setter Property="MinWidth" Value="123" />
                    <Setter Property="FontSize" Value="15" />
                    <Setter Property="HorizontalContentAlignment" Value="Right" />
                    <Setter Property="VerticalContentAlignment" Value="Bottom" />
                    <Setter Property="Padding" Value="0,0,9,4" />
                    <Setter Property="Background" Value="{StaticResource FunctionKeyBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Caps">
                    <Setter Property="MinWidth" Value="123" />
                    <Setter Property="FontSize" Value="13" />
                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                    <Setter Property="VerticalContentAlignment" Value="Bottom" />
                    <Setter Property="Padding" Value="9,0,0,6" />
                    <Setter Property="Background" Value="{StaticResource FunctionKeyBrush}" />
                    <Setter Property="Tag" Value="{StaticResource LedOffBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="ABC">
                    <Setter Property="MinWidth" Value="123" />
                    <Setter Property="FontSize" Value="13" />
                    <Setter Property="Background" Value="{StaticResource FunctionKeyBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="NUM">
                    <Setter Property="MinWidth" Value="123" />
                    <Setter Property="FontSize" Value="13" />
                    <Setter Property="Background" Value="{StaticResource FunctionKeyBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="SYM">
                    <Setter Property="MinWidth" Value="123" />
                    <Setter Property="FontSize" Value="13" />
                    <Setter Property="Background" Value="{StaticResource FunctionKeyBrush}" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Kind}" Value="Caps" />
                        <Condition Binding="{Binding DataContext.IsCaps, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="White" />
                    <Setter Property="BorderBrush" Value="#8E8E93" />
                    <Setter Property="Tag" Value="{StaticResource LedOnBrush}" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Kind}" Value="Shift" />
                        <Condition Binding="{Binding DataContext.IsShift, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="White" />
                    <Setter Property="BorderBrush" Value="#8E8E93" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid Margin="15" Focusable="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Height="50"
            Margin="0,10"
            Background="White"
            BorderBrush="#CFCFCF"
            BorderThickness="1"
            CornerRadius="8">
            <TextBox
                Name="ValueText"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Background="Transparent"
                BorderThickness="0"
                Focusable="False"
                FontSize="17"
                Foreground="#1D1D1F"
                IsReadOnly="True"
                IsTabStop="False"
                Text="{Binding Input}" />
        </Border>

        <ItemsControl Grid.Row="1" ItemsSource="{Binding Rows}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="4" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <ItemsControl ItemsSource="{Binding}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button
                                    Command="{Binding DataContext.PressKeyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    Content="{Binding Label}"
                                    Style="{StaticResource KeyboardButtonStyle}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel
            Grid.Row="2"
            Margin="0,10,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                x:Name="CancelButton"
                Width="110"
                Click="Button_OnClick"
                Content="Cancel"
                Style="{StaticResource KeyButtonStyle}" />
            <Button
                x:Name="EnterButton"
                Width="110"
                Click="Button_OnClick"
                Content="Enter"
                Style="{StaticResource KeyButtonStyle}" />
        </StackPanel>

    </Grid>
</Window>
